### Submit a correct solution for the seeded task
POST {{host}}/api/submissions
Content-Type: application/json

{
  "taskId": "{{taskId}}",
  "sourceCode":"import java.util.Arrays; import java.util.Scanner; public class Main { static int[] tideCompress(int[] values) { if (values.length == 0) return new int[0]; int[] result = new int[values.length]; int size = 1; result[0] = values[0]; int previousDirection = 0; for (int i = 1; i < values.length; i++) { int direction = Integer.compare(values[i], values[i - 1]); if (direction == 0) { result[size++] = values[i]; previousDirection = 0; } else if (direction == previousDirection) { result[size - 1] = values[i]; } else { result[size++] = values[i]; previousDirection = direction; } } return Arrays.copyOf(result, size); } public static void main(String[] args) { Scanner scanner = new Scanner(System.in); int n = scanner.nextInt(); int[] values = new int[n]; for (int i = 0; i < n; i++) values[i] = scanner.nextInt(); int[] result = tideCompress(values); for (int i = 0; i < result.length; i++) { if (i > 0) System.out.print(\" \"); System.out.print(result[i]); } System.out.println(); } }"
}

### Submit an intentionally incorrect solution
POST {{host}}/api/submissions
Content-Type: application/json

{
  "taskId": "{{taskId}}",
  "sourceCode": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        var scanner = new Scanner(System.in);\n        int n = scanner.nextInt();\n        long sum = 0;\n        for (int i = 0; i < n; i++) {\n            sum += scanner.nextLong();\n        }\n        System.out.println(sum + 1);\n    }\n}"
}

### Get a submission by id
GET {{host}}/api/submissions/{{submissionId}}
Accept: application/json
